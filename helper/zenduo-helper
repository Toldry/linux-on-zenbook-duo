#!/bin/bash
# zenduo-helper — the ONLY zenduo code that runs as root (via the NOPASSWD
# sudoers rule installed by system/50-sudoers.sh, scoped to exactly
# this binary at /usr/local/sbin/zenduo-helper).
#
# Verbs (input strictly validated, nothing else accepted):
#   backlight <device> <0-100>   write a percentage to /sys/class/backlight/<device>
#   batlimit <20-100>            set BAT* charge_control_end_threshold
#   login-layout [--quiet]       copy the caller's ~/.config/monitors.xml to the
#                                login screen's own copy, so the greeter comes up
#                                on the monitor they last used
set -euo pipefail
# sudo keeps the caller's PATH when sudoers has no secure_path, and their
# locale either way. Neither may decide which programs root runs or how the
# checks below read bytes. (The shebang is a fixed path for the same reason:
# `env bash` would search the caller's PATH.)
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

usage() {
  echo "usage: zenduo-helper backlight <device> <0-100> | batlimit <20-100>" >&2
  echo "       zenduo-helper login-layout [--quiet]" >&2
  exit 64
}

# Every element name mutter's monitors.xml parser knows
# (src/backends/meta-monitor-config-store.c, read 2026-09-12). A file is only
# installed if it uses nothing else: the greeter's Mutter reads it as its own
# display config, before anyone logs in, so "it came from the user" is not on
# its own enough.
XML_TAGS="monitors configuration logicalmonitor x y scale primary presentation
transform rotation flipped monitor monitorspec connector vendor product serial
mode width height rate ratemode flag underscanning maxbpc rgbrange disabled
policy stores store dbus migrated"

# Run a command as another account, with no way back to root.
as_user() { # <uid> <gid> <command...>
  local u="$1" g="$2"
  shift 2
  setpriv --reuid="$u" --regid="$g" --init-groups --no-new-privs -- "$@"
}

# The greeter's half of login-layout, run as gdm with the checked file on
# stdin. $1 is the greeter's config directory, $2 is 1 for --quiet.
GDM_INSTALL="$(cat <<'GDM'
set -euo pipefail
dir="$1" quiet="$2"
dst="$dir/monitors.xml"
say() { [ "$quiet" = 1 ] || echo "zenduo-helper: $*"; }
umask 022
mkdir -p -- "$dir"
new="$(mktemp "$dir/.monitors.xml.XXXXXX")"
trap 'rm -f -- "$new"' EXIT
cat > "$new"
# Back up the greeter's own file once, and leave a marker when there was
# none, so uninstall.sh can tell "restore theirs" from "remove ours".
if [ ! -e "$dst.zenduo-backup" ] && [ ! -e "$dst.zenduo-installed" ]; then
  if [ -e "$dst" ]; then
    cp -a -- "$dst" "$dst.zenduo-backup"
    say "kept the login screen's own layout as $dst.zenduo-backup"
  else
    : > "$dst.zenduo-installed"
  fi
fi
if cmp -s -- "$new" "$dst"; then
  say "login screen layout already up to date"
  exit 0
fi
chmod 0644 -- "$new"
mv -f -- "$new" "$dst"
say "login screen will use the remembered layouts ($dst)"
GDM
)"

case "${1:-}" in
  backlight)
    dev="${2:-}"
    pct="${3:-}"
    [[ "$dev" =~ ^[A-Za-z0-9._:-]+$ ]] || usage
    case "$dev" in *..*) usage ;; esac
    [[ "$pct" =~ ^[0-9]{1,3}$ ]] || usage
    # Force base 10 before any arithmetic: bash reads a leading-zero operand as
    # OCTAL, so a validated "010" would write 8% instead of 10%, and "08"/"09"
    # would abort with "value too great for base" under set -e.
    pct=$((10#$pct))
    [ "$pct" -le 100 ] || usage
    base="/sys/class/backlight/$dev"
    if [ ! -e "$base/brightness" ] || [ ! -e "$base/max_brightness" ]; then
      echo "zenduo-helper: no such backlight device: $dev" >&2
      exit 66
    fi
    max="$(cat "$base/max_brightness")"
    # Bash arithmetic evaluates a variable's text as an expression.
    [[ "$max" =~ ^[0-9]{1,9}$ ]] || { echo "zenduo-helper: $base/max_brightness is not a number" >&2; exit 66; }
    echo $(( max * pct / 100 )) > "$base/brightness"
    ;;
  batlimit)
    pct="${2:-}"
    [[ "$pct" =~ ^[0-9]{1,3}$ ]] || usage
    pct=$((10#$pct))  # normalize like the backlight verb (see the note above)
    if [ "$pct" -lt 20 ] || [ "$pct" -gt 100 ]; then
      usage
    fi
    found=0
    for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
      [ -e "$f" ] || continue
      echo "$pct" > "$f"
      found=1
    done
    [ "$found" = 1 ] || { echo "zenduo-helper: no charge_control_end_threshold node (asus-wmi missing?)" >&2; exit 66; }
    ;;
  login-layout)
    quiet=0
    [ "${2:-}" = "--quiet" ] && quiet=1
    say() { [ "$quiet" = 1 ] || echo "zenduo-helper: $*"; }
    command -v setpriv >/dev/null 2>&1 \
      || { echo "zenduo-helper: login-layout needs setpriv (util-linux)" >&2; exit 69; }
    cd /

    # The caller is identified by sudo, never by an argument: an argument
    # would let one user publish another user's file to the greeter.
    uid="${SUDO_UID:-}"
    [[ "$uid" =~ ^[0-9]+$ ]] || { echo "zenduo-helper: login-layout must be run through sudo" >&2; exit 64; }
    # `|| true` inside the substitution: getent exits 2 for an unknown key and
    # pipefail would take the whole script down before the check below runs.
    IFS=: read -r _ _ _ gid _ src_home _ <<<"$(getent passwd "$uid" 2>/dev/null || true)"
    [ -n "$src_home" ] || { echo "zenduo-helper: uid $uid has no home directory" >&2; exit 66; }
    [[ "$gid" =~ ^[0-9]+$ ]] || { echo "zenduo-helper: uid $uid has no primary group" >&2; exit 66; }
    src="$src_home/.config/monitors.xml"

    # Root never opens a path in the caller's home. It would follow any
    # symlink they put there, and a check followed by a second open can be
    # raced with a swap in between. So the file is read once, as the caller,
    # through a pipe into a directory only root can see. Every check below
    # and the install itself use that one copy.
    as_user "$uid" "$gid" test -f "$src" </dev/null \
      || { echo "zenduo-helper: $src does not exist yet (nothing remembered)" >&2; exit 66; }
    work="$(mktemp -d /tmp/zenduo-helper.XXXXXXXX)"
    trap 'rm -rf "$work"' EXIT
    copy="$work/monitors.xml"
    read_rc=0
    as_user "$uid" "$gid" cat -- "$src" </dev/null | timeout 10 head -c 65537 > "$copy" || read_rc=$?

    # Validation, in the order that a bad file could do harm: a sane size, no
    # doctype/processing instruction/comment, and no element mutter does not
    # know. A file that fails any of these is not installed; the greeter then
    # keeps whatever it had. Ownership is not checked: the copy holds bytes
    # the caller could read anyway, so these checks are what guard the greeter.
    size="$(stat -c %s "$copy")"
    [[ "$size" -gt 0 && "$size" -le 65536 ]] \
      || { echo "zenduo-helper: $src is empty or over 65536 bytes; refusing" >&2; exit 65; }
    [ "$read_rc" = 0 ] || { echo "zenduo-helper: could not read $src (rc=$read_rc)" >&2; exit 65; }
    head_line="$(head -c 64 "$copy" | head -n1)"
    case "$head_line" in
      '<monitors version="2">'*) ;;
      *) echo "zenduo-helper: $src does not start with <monitors version=\"2\"> — refusing" >&2; exit 65 ;;
    esac
    # A NUL byte makes grep call the file binary and print no matches, which
    # would let any element past the list below.
    [ "$(tr -d '\000' < "$copy" | wc -c)" = "$size" ] \
      || { echo "zenduo-helper: $src contains a NUL byte; refusing" >&2; exit 65; }
    # Captured, then matched: a pipe into grep -q under pipefail returns 141
    # on a file big enough to fill the pipe (docs/DESIGN.md).
    specials="$(grep -ac -e '<!' -e '<?' "$copy" || true)"
    [ "$specials" = 0 ] \
      || { echo "zenduo-helper: $src contains a doctype, comment or processing instruction — refusing" >&2; exit 65; }
    # The whole name after each "<" or "</", so "monitor-x" or "x:y" is not
    # read as "monitor" or "x".
    tags="$(grep -aoE '</?[^[:space:]/<>]*' "$copy" | sed -E 's#^</?##' | sort -u)"
    # One name per line, never word-split: a name such as "*" must not glob.
    while IFS= read -r tag; do
      found=0
      for known in $XML_TAGS; do
        [ "$tag" = "$known" ] && { found=1; break; }
      done
      [ "$found" = 1 ] || { echo "zenduo-helper: $src has an unknown element <$tag> — refusing" >&2; exit 65; }
    done <<<"$tags"

    IFS=: read -r _ _ gdm_uid gdm_gid _ gdm_home _ <<<"$(getent passwd gdm 2>/dev/null || true)"
    [[ -n "$gdm_home" && "$gdm_uid" =~ ^[0-9]+$ && "$gdm_gid" =~ ^[0-9]+$ ]] \
      || { echo "zenduo-helper: no gdm account — the login screen is not GDM's to set" >&2; exit 66; }
    # Every write in the greeter's home happens as gdm. Root writing there
    # would follow any symlink the gdm account left in its own directory.
    as_user "$gdm_uid" "$gdm_gid" bash -c "$GDM_INSTALL" zenduo-helper "$gdm_home/.config" "$quiet" < "$copy"
    ;;
  *)
    usage
    ;;
esac
